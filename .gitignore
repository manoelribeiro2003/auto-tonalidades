### Node ###
# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Instrumented libraries
lib-cov/

# Coverage
coverage/
*.lcov
.nyc_output/

# Grunt
.grunt/

# Bower
bower_components/

# Compiled binary addons
build/Release/

# Dependencies
node_modules/
jspm_packages/
web_modules/

# TypeScript
*.tsbuildinfo

# Caches
.npm/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.node_repl_history

# Environment variables
.env
.env.*
!.env.example

# Build outputs
dist/
dist-electron/
out/
.next/
.nuxt/
.vuepress/dist/
.svelte-kit/
.docusaurus/
.serverless/
.fusebox/
.webpack/
.temp/

# Package archives
*.tgz
.yarn-integrity

# Yarn
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# VS Code tests
.vscode-test/

# Electron
# Instaladores e artefatos de distribuição
release/
artifacts/

# Dados locais do Electron
# Não ignorar resources/ nem arquivos HTML/TS do projeto

# Arquivos temporários do Excel
~$*.xls
~$*.xlsx
~$*.xlsm
